{
  "name": "CompanyProfile",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "mockup_url": {
      "type": "string"
    },
    "vehicle_type": {
      "type": "string"
    },
    "vehicle_color": {
      "type": "string"
    },
    "vehicle_year": {
      "type": "string"
    },
    "design_style": {
      "type": "string"
    }
  },
  "required": [
    "company_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {},
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}