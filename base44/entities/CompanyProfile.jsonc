{
  "name": "CompanyProfile",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "reference_file_url": {
      "type": "string"
    },
    "blueprint_front_url": {
      "type": "string"
    },
    "blueprint_side_url": {
      "type": "string"
    },
    "mockup_url": {
      "type": "string"
    },
    "right_mockup_url": {
      "type": "string"
    },
    "front_mockup_url": {
      "type": "string"
    },
    "rear_mockup_url": {
      "type": "string"
    },
    "vehicle_type": {
      "type": "string"
    },
    "vehicle_color": {
      "type": "string"
    },
    "vehicle_year": {
      "type": "string"
    },
    "design_style": {
      "type": "string"
    },
    "wrap_type": {
      "type": "string",
      "enum": [
        "Full Wrap",
        "Half Wrap",
        "Simple"
      ],
      "default": "Full Wrap"
    },
    "rear_window_graphics": {
      "type": "string"
    },
    "rear_window_perforated": {
      "type": "boolean",
      "default": false
    },
    "rear_chevron": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "design_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "company_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {},
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}